# App del conductor de Smayta Transporte.
# Copiar como .env (no se sube a Git: está en .gitignore) y rellenar FLEETBASE_KEY.

APP_NAME=Smayta Transporte
APP_IDENTIFIER=es.smayta.transporte
APP_LINK_PREFIX=flbnavigator

# API de Fleetbase de Smayta Transporte (servidor de pruebas).
FLEETBASE_HOST=https://api-transporte.2-29-220-121.sslip.io
# Clave pública de la API (flb_live_…), creada en la consola de Fleetbase:
# Developers → API Keys, una solo para la app («Navigator»). Nunca en Git.
FLEETBASE_KEY=

# Avisos en directo (ofertas de viaje, cambios de pedido): por el Caddy de Smayta.
SOCKETCLUSTER_HOST=socket-transporte.2-29-220-121.sslip.io
SOCKETCLUSTER_PORT=443
SOCKETCLUSTER_SECURE=true

# Mapas: clave de Google Maps restringida a la app (Android e iOS).
GOOGLE_MAPS_API_KEY=

# Centro del mapa antes de tener la ubicación del conductor (Madrid).
DEFAULT_COORDINATES=40.4168,-3.7038
