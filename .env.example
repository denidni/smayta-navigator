# Smayta Transporte, app del conductor (basada en Fleetbase Navigator).
# Copia este fichero a `.env` (no entra en Git) y pon la clave de la app.

APP_NAME="Smayta Transporte"
# Identificador de la app en Google Play y App Store. NO se puede cambiar una vez publicada.
APP_IDENTIFIER=com.smayta.transporte
APP_LINK_PREFIX=smaytatransporte

# Servidor de Fleetbase de Smayta (ahora el de pruebas; cambiar al definitivo antes de publicar).
FLEETBASE_HOST=https://api-transporte.2-29-220-121.sslip.io
# Clave pública «Navigator» de la consola de Fleetbase (flb_live_…). No se sube a Git.
FLEETBASE_KEY=
SOCKETCLUSTER_HOST=socket-transporte.2-29-220-121.sslip.io
SOCKETCLUSTER_PORT=443
SOCKETCLUSTER_SECURE=true

GOOGLE_MAPS_API_KEY=
# Castellón de la Plana (centro del mapa sin posición del conductor).
DEFAULT_COORDINATES=39.986,-0.0513
DEFAULT_LOCALE=es

# Marca: colores de Smayta (tamagui.config.ts, temas lightSmayta/darkSmayta).
APP_THEME=smayta

# Páginas de Smayta en la cuenta del conductor y el código de la app (AGPL).
TERMS_URL=https://smayta.es/info/condiciones
PRIVACY_URL=https://smayta.es/info/privacidad
SOURCE_CODE_URL=https://github.com/denidni/smayta-navigator
# «Borrar mi cuenta» (lo exigen Google Play y la App Store). En Argelia: https://smayta.dz/dz/borrar-cuenta
DELETE_ACCOUNT_URL=https://smayta.es/es/borrar-cuenta

# Cuenta de Smayta dentro de la app (alta de conductores, documentos, identidad y saldo).
# La API de tienda de Smayta y su clave publicable (pk_…, pública: la misma que la tienda web).
SMAYTA_API_URL=https://api.2-29-220-121.sslip.io
SMAYTA_PUBLISHABLE_KEY=
# Tienda web (recargar la cartera, contraseña olvidada).
SMAYTA_WEB_URL=https://tienda.2-29-220-121.sslip.io
# País por defecto del alta de conductores: ES o DZ.
DEFAULT_COUNTRY=ES
