# Smayta Transporte, app del conductor (basada en Fleetbase Navigator).
# Copia este fichero a `.env` (no entra en Git) y pon la clave de la app.

APP_NAME="Smayta Transporte"
# Identificador de la app en Google Play y App Store. NO se puede cambiar una vez publicada.
APP_IDENTIFIER=com.smayta.transporte
APP_LINK_PREFIX=smaytatransporte

# Servidor de Fleetbase de Smayta (ahora el de pruebas; cambiar al definitivo antes de publicar).
FLEETBASE_HOST=https://api-transporte.2-29-220-121.sslip.io
# Clave pública «Navigator» de la consola de Fleetbase (flb_live_…). No se sube a Git.
FLEETBASE_KEY=
SOCKETCLUSTER_HOST=socket-transporte.2-29-220-121.sslip.io
SOCKETCLUSTER_PORT=443
SOCKETCLUSTER_SECURE=true

GOOGLE_MAPS_API_KEY=
# Castellón de la Plana (centro del mapa sin posición del conductor).
DEFAULT_COORDINATES=39.986,-0.0513
DEFAULT_LOCALE=es
